{
  "manifest_version": 3,
  "name": "Ganesmart Reader",
  "version": "0.2.0",
  "description": "Syncs your Edunex and SIX deadlines straight from each site, using the login already in your browser. Never stores or sends your login, grades, or files.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.itb.ac.id/*",
    "*://*.cognisia.id/*",
    "https://goitb.id/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.itb.ac.id/*",
        "*://*.cognisia.id/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://edunex.itb.ac.id/*"],
      "js": ["edunex-sync.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://six.itb.ac.id/*"],
      "js": ["six-sync.js"],
      "run_at": "document_idle"
    }
  ]
}