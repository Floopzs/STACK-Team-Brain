{
  "manifest_version": 3,
  "name": "Ganesmart Reader",
  "version": "0.1.0",
  "description": "Local-first deadline and class schedule reader for open Edunex, SIX, and Microsoft Teams pages without touching credentials, tokens, or grades.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.itb.ac.id/*",
    "*://*.cognisia.id/*",
    "*://*.cloud.microsoft/*",
    "*://*.microsoft.com/*",
    "*://*.office.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.itb.ac.id/*",
        "*://*.cognisia.id/*",
        "*://*.cloud.microsoft/*",
        "*://*.microsoft.com/*",
        "*://*.office.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}